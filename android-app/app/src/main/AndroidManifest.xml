<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ (API 30+) esconde otras apps por defecto (package visibility).
         Sin esto, bindService() al servicio de impresión de Sunmi falla en
         silencio ("no se pudo conectar con el servicio de impresión") aunque
         el servicio exista y esté corriendo. -->
    <queries>
        <package android:name="woyou.aidlservice.jiuiv5" />
        <intent>
            <action android:name="woyou.aidlservice.jiuiv5.IWoyouService" />
        </intent>
    </queries>

    <application
        android:label="Sunmi Print Bridge"
        android:allowBackup="false"
        android:theme="@style/Theme.Transparent">

        <activity
            android:name=".PrintActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sunmiprint" android:host="print" />
            </intent-filter>
            <!-- También lanzable desde el cajón de apps, para probar sin navegador -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
